{
  "name": "the-property-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "eslint",
    "playwright:install": "playwright install",
    "mcp:playwright": "node -e \"console.log('Playwright MCP server package pending. Configure .cursor/mcp.json when available.')\"",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "guide:screenshots": "FULL_GUIDE_CAPTURE=true playwright test tests/guide/screenshots.spec.ts",
    "guide:screenshots:en": "playwright test tests/guide/screenshots.spec.ts --grep 'EN Screenshots'",
    "guide:seed": "npx tsx tests/guide/fixtures/guide-seed.ts",
    "guide:pdf:en": "node scripts/generate-guide-pdf.mjs docs/user-guide/en/README.md public/downloads/user-guide-en.pdf",
    "guide:pdf:it": "node scripts/generate-guide-pdf.mjs docs/user-guide/it/README.md public/downloads/user-guide-it.pdf",
    "guide:pdf:all": "npm run guide:pdf:en && npm run guide:pdf:it",
    "guide:update": "npm run guide:seed && npm run guide:screenshots && npm run guide:pdf:all"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.0",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.4",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.553.0",
    "md-to-pdf": "^5.2.5",
    "next": "^16.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-joyride": "^2.9.3",
    "react-loading-skeleton": "^3.5.0",
    "resend": "^6.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "twilio": "^5.11.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@playwright/test": "^1.47.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.7",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.47.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "qs": "^6.14.1"
  }
}
