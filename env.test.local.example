# Test Environment Variables Example
# Copy this file to .env.test.local and fill in your actual test credentials
# NEVER commit .env.test.local to git!

# Test Agent Credentials
TEST_AGENT_EMAIL=your-agent-email@example.com
TEST_AGENT_PASSWORD=your-secure-password-here

# Test Buyer Credentials (optional, for invite tests)
TEST_BUYER_EMAIL=your-buyer-email@example.com
TEST_BUYER_PASSWORD=your-buyer-password-here

# Supabase Test Configuration (if different from .env.local)
# TEST_SUPABASE_URL=https://your-project.supabase.co
# TEST_SUPABASE_ANON_KEY=your-anon-key-here

